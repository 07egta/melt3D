+#[test]
+fn cancellation_during_matching_leaves_the_source_surface_intact() {
+    use std::sync::Arc;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    struct StopAfter(AtomicUsize);
+    impl crate::watch::Watch for StopAfter {
+        fn cancelled(&self) -> bool {
+            self.0.fetch_add(1, Ordering::Relaxed) >= 300
+        }
+        fn progress(&self, _: &'static str, _: usize, _: usize) {}
+    }
+    let (target, picks) = cylinder_and_picks();
+    let (sheet, face) = sheet_and_pick();
+    let source = sheet.solid.clone();
+    let stop = Arc::new(StopAfter(AtomicUsize::new(0)));
+    let error = crate::watch::watching(stop.clone(), || match_surface(&sheet, &face, &target, &picks, Continuity::G3)).unwrap_err();
+    assert!(error.to_string().contains("cancelled"), "{error}");
+    assert_eq!(stop.0.load(Ordering::Relaxed), 301, "stop at the next checkpoint");
+    assert!(Arc::ptr_eq(&source, &sheet.solid));
+    let made = match_surface(&sheet, &face, &target, &picks, Continuity::G3).unwrap();
+    let (gap, angle, order) = seam_continuity(&made, &target, &picks).unwrap();
+    assert!(gap < 1e-6 && angle < 0.05);
+    assert_eq!(order, Some(Continuity::G3));
+}
