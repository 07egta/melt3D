+fn stored_body_frame(app: &SolveApp, body: &str, fallback: &Mat) -> Mat {
+    let state = app.session.model.state();
+    app.session.doc.body_frames(&state).into_iter().find(|(name, _, _, _)| name == body).map_or(*fallback, |(_, _, _, frame)| frame)
+}
