+        .unwrap()["created"]["curves"][0]
+        .as_str()
+        .unwrap()
+        .to_string();
+    app.run("sketch.finish", json!({})).unwrap();
+    app.run("surface.extrude", json!({"sketch":"Sheet sketch", "curves":[arc], "distance":30, "body_name":"Source"})).unwrap();
+    picks
+}
