+#[test]
+fn separated_parallel_planes_fail_g0_before_any_higher_order_is_reported() {
+    let plane = |z: f64| {
+        let side = |x: f64, direction: f64| {
+            [0.0, 10.0].map(|y| Frame { p: Vec3::new(x, y, z), leave: Vec3::new(direction, 0.0, 0.0), bend: Vec3::ZERO, bend_change: Vec3::ZERO })
+        };
+        bridge::bridge(&side(0.0, 1.0), &side(10.0, -1.0), [Continuity::G1, Continuity::G1], [0.0, 0.0]).unwrap()
+    };
+    let target = plane(0.0);
+    let separated = plane(1.0);
+    let picks = [Vec3::new(0.0, 2.0, 0.0), Vec3::new(0.0, 8.0, 0.0)];
+    let (gap, angle, order) = seam_continuity(&separated, &target, &picks).unwrap();
+    assert!((gap - 1.0).abs() < 1e-9);
+    assert!(angle < G1_DEG);
+    assert_eq!(order, None, "parallel normals cannot hide a failed position tolerance");
+    let (_, _, relaxed) = seam_continuity_with_tolerance(&separated, &target, &picks, 1.1).unwrap();
+    assert!(relaxed.is_some(), "only an explicit looser tolerance can accept this gap");
+    let (_, _, joined) = seam_continuity(&target, &target, &picks).unwrap();
+    assert!(joined.is_some());
+    for tolerance in [-1.0, f64::NAN, f64::INFINITY] {
+        assert!(seam_continuity_with_tolerance(&separated, &target, &picks, tolerance).is_err());
+    }
+}
