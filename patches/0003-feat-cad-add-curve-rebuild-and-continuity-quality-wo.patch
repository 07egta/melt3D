+/// Restore picks within their stored body. Coincident faces on another body must not silently
+/// become Match's source or target when a feature is opened for editing.
+fn stored_faces(app: &SolveApp, body: &str, faces: &[solidcraft_engine::doc::FacePick], frame: &Mat) -> Option<Vec<Sel>> {
+    let state = app.session.world_state();
+    let model = state.body(body)?;
+    if faces.is_empty() {
+        return Some(vec![Sel::Body { name: body.into() }]);
+    }
+    let frame = stored_body_frame(app, body, frame);
+    faces
+        .iter()
+        .map(|pick| {
+            let point = solidcraft_engine::doc::apply_point(&frame, pick.0);
+            let index = solidcraft_engine::doc::appearance::face_index_at(model, point)?;
+            Some(Sel::Face { body: body.into(), index, point })
+        })
+        .collect()
+}
+
+fn stored_edges(app: &SolveApp, body: &str, edges: &[Position], frame: &Mat) -> Option<Vec<Sel>> {
+    let state = app.session.world_state();
+    let model = state.body(body)?;
+    let mesh = model.mesh();
+    let frame = stored_body_frame(app, body, frame);
+    edges
+        .iter()
+        .map(|pick| {
+            let point = solidcraft_engine::doc::apply_point(&frame, pick.0);
+            let (index, distance) = mesh
+                .edges
+                .iter()
+                .enumerate()
+                .map(|(index, line)| {
+                    let distance = line.windows(2).map(|pair| point.dist_to_segment(pair[0], pair[1])).fold(f64::INFINITY, f64::min);
+                    (index, distance)
+                })
+                .min_by(|(_, a), (_, b)| a.total_cmp(b))?;
+            (distance <= model.display_tol() + 1e-6 * point.len()).then(|| Sel::Edge { body: body.into(), index, point })
+        })
+        .collect()
+}
