+/// Long print operations cooperate with the editor's cancellation token too, rather than
+/// waiting until the next node to notice Stop.
+pub(crate) fn run_until(c: &Component, args: &[Value], stop: &dyn Fn() -> bool) -> Run {
+    if stop() {
+        return Err("stopped".into());
+    }
+    match c.name {
+        "Slice" => {
+            let Value::Solid(triangles) = arg(args, 0)? else { return Err("connect a solid".into()) };
+            let layers = solidcraft_slice::slice_until(triangles, num(args, 1)?, stop).map_err(|error| error.to_string())?;
+            Ok(vec![vec![Value::Layers(Arc::new(layers))]])
+        }
+        "G-code" => {
+            let Value::Layers(layers) = arg(args, 0)? else { return Err("connect sliced layers".into()) };
+            let config = print_config(num(args, 1)?, num(args, 2)?, num(args, 3)?, num(args, 4)?, num(args, 5)?);
+            let text = solidcraft_slice::gcode_until(layers, &config, stop).map_err(|error| error.to_string())?;
+            Ok(vec![vec![Value::Text(text)]])
+        }
+        _ => (c.run)(args),
+    }
+}
