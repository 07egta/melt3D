+
+fn host_recovery_params(paths: &HostPaths, params: &mut Value) -> Result<(), &'static str> {
+    if params.is_null() {
+        *params = serde_json::json!({});
+    }
+    let object = params.as_object_mut().ok_or("host.recovery_parameters")?;
+    match object.get("dir") {
+        None | Some(Value::Null) => {}
+        Some(Value::String(dir)) if dir.trim().is_empty() => {}
+        Some(Value::String(dir)) if dir.len() < 4096 => return Ok(()),
+        _ => return Err("host.recovery_directory"),
+    }
+    let dir = paths.recovery.as_ref().ok_or("host.recovery_unavailable")?;
+    let dir = dir.to_str().filter(|dir| !dir.trim().is_empty() && dir.len() < 4096).ok_or("host.recovery_directory")?;
+    object.insert("dir".into(), Value::String(dir.into()));
+    Ok(())
+}
