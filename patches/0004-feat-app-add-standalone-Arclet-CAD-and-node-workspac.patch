+/// Per-user folders chosen by the application embedding this UI. A missing folder
+/// disables that service; it never selects another application's default folder.
+#[derive(Clone, Debug, Default)]
+pub struct HostPaths {
+    pub recovery: Option<std::path::PathBuf>,
