+/// Scripts execute inside the engine, so apply the host's folder choice before
+/// handing them over. Ordinary scripts and legacy hosts retain their original value.
+fn host_script<'a>(app: &SolveApp, script: &'a Value) -> Result<std::borrow::Cow<'a, Value>, String> {
+    use std::borrow::Cow;
+    if app.services.paths.is_none() {
+        return Ok(Cow::Borrowed(script));
+    }
+    let Some(steps) = script.as_array().or_else(|| script.get("commands").and_then(Value::as_array)) else {
+        return Ok(Cow::Borrowed(script));
