+            .filter(|command| matches!(command.id, "doc.recovery_list" | "doc.recover" | "doc.recovery_discard"))
+            .map(|command| command.id)
+    };
+    if !steps.iter().any(|step| recovery_command(step).is_some()) {
+        return Ok(Cow::Borrowed(script));
+    }
+    let mut scoped = script.clone();
+    let steps = match &mut scoped {
+        Value::Array(steps) => Some(steps),
+        Value::Object(object) => object.get_mut("commands").and_then(Value::as_array_mut),
+        _ => None,
+    };
+    if let Some(steps) = steps {
+        for step in steps {
+            if let Some(command) = recovery_command(step)
+                && let Some(object) = step.as_object_mut()
+            {
+                let params = object.entry("params").or_insert(Value::Null);
+                app.host_command_params(command, params)?;
+            }
+        }
+    }
+    Ok(Cow::Owned(scoped))
+}
