diff --git a/crates/ui-egui/src/node_editor.rs b/crates/ui-egui/src/node_editor.rs
new file mode 100644
index 0000000..79311e0
--- /dev/null
+++ b/crates/ui-egui/src/node_editor.rs
@@ -0,0 +1,512 @@
+//! A small visual graph workspace shared by the desktop and browser hosts.
+//! The host owns file pickers and mesh insertion; this module never opens a modal dialog.
+
+use std::sync::Arc;
+#[cfg(not(target_arch = "wasm32"))]
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use egui::{Ui, vec2};
+use solidcraft_graph::{Evaluation, Graph, GraphError, Modifier, NodeId, Value};
+
+use crate::i18n::tr;
+use crate::theme::Tokens;
+
+mod canvas;
+mod inspector;
+#[cfg(test)]
+mod tests;
+
+const MAX_ERROR_CHARS: usize = 512;
+
+pub type NodeMesh = Arc<Vec<[solidcraft_engine::geom::Vec3; 3]>>;
+
+/// Requests which the native/web host can fulfil using its existing services.
+pub enum NodeAction {
+    SaveJson(String),
+    OpenJson,
+    PreviewMesh(NodeMesh),
+    ExportGcode(String),
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+struct Job {
+    result: std::sync::mpsc::Receiver<Result<Evaluation, GraphError>>,
+    cancel: Arc<AtomicBool>,
+    revision: u64,
+}
+
+#[cfg(target_arch = "wasm32")]
+struct Job {
+    evaluation: solidcraft_graph::PreviewEvaluation,
+    revision: u64,
+}
+
+/// Editable document, transient gesture state, and one active evaluation at most.
+pub struct NodeEditor {
+    graph: Graph,
+    selected: Option<NodeId>,
+    evaluation: Option<Evaluation>,
+    job: Option<Job>,
+    revision: u64,
+    evaluated_revision: Option<u64>,
+    pending_run: bool,
+    auto_run: bool,
+    last_change: f64,
+    error: Option<String>,
+    placing: Option<&'static str>,
+    wire_start: Option<(NodeId, usize)>,
+    drag: Option<(NodeId, (f32, f32))>,
+    undo: Vec<Graph>,
+    redo: Vec<Graph>,
+    number_edit: Option<Graph>,
+    scroll_to: Option<NodeId>,
+    saved_graph: Option<Graph>,
+}
+
+impl Default for NodeEditor {
+    fn default() -> Self {
+        let graph = sample_graph().unwrap_or_default();
+        let selected = graph.nodes.keys().next_back().copied();
+        Self {
+            graph,
+            selected,
+            evaluation: None,
+            job: None,
+            revision: 0,
+            evaluated_revision: None,
+            pending_run: true,
+            auto_run: true,
+            last_change: 0.0,
+            error: None,
+            placing: None,
+            wire_start: None,
+            drag: None,
+            undo: Vec::new(),
+            redo: Vec::new(),
+            number_edit: None,
+            scroll_to: None,
+            saved_graph: None,
+        }
+    }
+}
+
+impl Drop for NodeEditor {
+    fn drop(&mut self) {
+        self.cancel();
+    }
+}
+
+/// A working starter: a circle and a height control connected to an extrusion.
+pub fn sample_graph() -> Result<Graph, GraphError> {
+    let mut graph = Graph::new();
+    let circle = graph.add_node("Circle", (64.0, 72.0))?;
+    let height = graph.add_node("Number", (64.0, 290.0))?;
+    let extrude = graph.add_node("Extrude", (398.0, 140.0))?;
+    graph.set_constant(height, 0, Value::Number(18.0))?;
+    graph.connect_checked(circle, 0, extrude, 0)?;
+    graph.connect_checked(height, 0, extrude, 1)?;
+    Ok(graph)
+}
+
+impl NodeEditor {
+    pub fn graph(&self) -> &Graph {
+        &self.graph
+    }
+
+    pub fn evaluation(&self) -> Option<&Evaluation> {
+        self.evaluation.as_ref().filter(|_| self.evaluated_revision == Some(self.revision))
+    }
+
+    pub fn is_running(&self) -> bool {
+        self.job.is_some()
+    }
+
+    pub fn is_dirty(&self) -> bool {
+        self.saved_graph.as_ref() != Some(&self.graph)
+    }
+
+    pub fn mark_saved(&mut self) {
+        self.saved_graph = Some(self.graph.clone());
+    }
+
+    /// Mark the exact asynchronously saved snapshot, preserving dirty status for later edits.
+    pub fn mark_saved_json(&mut self, text: &str) -> Result<(), String> {
+        self.saved_graph = Some(Graph::from_json(text).map_err(|error| error.to_string())?);
+        Ok(())
+    }
+
+    pub fn to_json(&self) -> Result<String, String> {
+        self.graph.to_json().map_err(|error| error.to_string())
+    }
+
+    /// An invalid file leaves the current graph, output and undo history untouched.
+    pub fn load_json(&mut self, text: &str) -> Result<(), String> {
+        let graph = Graph::from_json(text).map_err(|error| error.to_string())?;
+        self.replace_graph(graph)?;
+        self.mark_saved();
+        Ok(())
+    }
+
+    pub fn replace_graph(&mut self, graph: Graph) -> Result<(), String> {
+        // Round-tripping uses the same finite-value and resource rules as file loading.
+        let text = graph.to_json().map_err(|error| error.to_string())?;
+        let graph = Graph::from_json(&text).map_err(|error| error.to_string())?;
+        self.checkpoint();
+        self.graph = graph;
+        self.selected = self.graph.nodes.keys().next_back().copied();
+        self.placing = None;
+        self.wire_start = None;
+        self.drag = None;
+        self.changed(0.0);
+        Ok(())
+    }
+
+    pub fn report_error(&mut self, error: impl Into<String>) {
+        // Parser errors can repeat an attacker-controlled field or component name. Bound the
+        // retained display text before egui lays it out, without cutting a UTF-8 character.
+        let error = error.into();
+        let mut chars = error.chars();
+        let mut display: String = chars.by_ref().take(MAX_ERROR_CHARS).collect();
+        if chars.next().is_some() {
+            display.pop();
+            display.push('…');
+        }
+        self.error = Some(display);
+    }
+
+    pub fn cancel(&mut self) {
+        self.pending_run = false;
+        #[cfg(not(target_arch = "wasm32"))]
+        if let Some(job) = &self.job {
+            job.cancel.store(true, Ordering::Relaxed);
+        }
+        #[cfg(target_arch = "wasm32")]
+        {
+            self.job = None;
+        }
+    }
+
+    fn checkpoint(&mut self) {
+        self.push_undo(self.graph.clone());
+    }
+
+    fn push_undo(&mut self, graph: Graph) {
+        const MAX_UNDO: usize = 24;
+        if self.undo.last() != Some(&graph) {
+            if self.undo.len() >= MAX_UNDO {
+                self.undo.remove(0);
+            }
+            self.undo.push(graph);
+        }
+        self.redo.clear();
+    }
+
+    fn changed(&mut self, now: f64) {
+        self.cancel();
+        self.revision = self.revision.wrapping_add(1);
+        self.last_change = now;
+        self.pending_run = self.auto_run;
+        self.error = None;
+    }
+
+    fn undo(&mut self, now: f64) {
+        if let Some(graph) = self.undo.pop() {
+            self.redo.push(std::mem::replace(&mut self.graph, graph));
+            self.selected = self.selected.filter(|id| self.graph.nodes.contains_key(id));
+            self.changed(now);
+        }
+    }
+
+    fn redo(&mut self, now: f64) {
+        if let Some(graph) = self.redo.pop() {
+            self.undo.push(std::mem::replace(&mut self.graph, graph));
+            self.changed(now);
+        }
+    }
+
+    /// Begin a run without blocking the host's UI. A repeated run cancels the active worker
+    /// and waits for it to exit before starting the next; slider drags cannot spawn a backlog.
+    pub fn run(&mut self, ctx: &egui::Context) {
+        self.cancel();
+        self.pending_run = true;
+        self.last_change = -1.0;
+        self.poll(ctx);
+    }
+
+    fn finish(&mut self, result: Result<Evaluation, GraphError>, revision: u64) {
+        if revision != self.revision {
+            return;
+        }
+        match result {
+            Ok(evaluation) => {
+                self.evaluation = Some(evaluation);
+                self.evaluated_revision = Some(revision);
+                self.error = None;
+            }
+            Err(GraphError::Cancelled) => {}
+            Err(error) => self.error = Some(error.to_string()),
+        }
+    }
+
+    fn poll(&mut self, ctx: &egui::Context) {
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            let received = self.job.as_ref().and_then(|job| match job.result.try_recv() {
+                Ok(result) => Some((result, job.revision)),
+                Err(std::sync::mpsc::TryRecvError::Disconnected) => Some((Err(GraphError::Invalid("evaluation worker closed".into())), job.revision)),
+                Err(std::sync::mpsc::TryRecvError::Empty) => None,
+            });
+            if let Some((result, revision)) = received {
+                self.job = None;
+                self.finish(result, revision);
+            }
+        }
+        #[cfg(target_arch = "wasm32")]
+        {
+            let finished = self.job.as_mut().and_then(|job| match job.evaluation.step(&|| false) {
+                Ok(false) => None,
+                result => Some(result),
+            });
+            if let Some(result) = finished
+                && let Some(job) = self.job.take()
+            {
+                self.finish(result.and_then(|_| job.evaluation.finish()), job.revision);
+            }
+        }
+        let now = ctx.input(|input| input.time);
+        if self.job.is_none() && self.pending_run && now - self.last_change >= 0.2 {
+            self.pending_run = false;
+            self.error = None;
+            #[cfg(not(target_arch = "wasm32"))]
+            {
+                let graph = self.graph.clone();
+                let cancel = Arc::new(AtomicBool::new(false));
+                let stop = cancel.clone();
+                let ctx = ctx.clone();
+                let (sender, result) = std::sync::mpsc::sync_channel(1);
+                match std::thread::Builder::new().name("node-evaluation".into()).spawn(move || {
+                    let evaluation = graph.evaluate_until(&|| stop.load(Ordering::Relaxed));
+                    let _ = sender.send(evaluation);
+                    ctx.request_repaint();
+                }) {
+                    Ok(_) => self.job = Some(Job { result, cancel, revision: self.revision }),
+                    Err(error) => self.error = Some(error.to_string()),
+                }
+            }
+            #[cfg(target_arch = "wasm32")]
+            match solidcraft_graph::PreviewEvaluation::new(self.graph.clone()) {
+                Ok(evaluation) => self.job = Some(Job { evaluation, revision: self.revision }),
+                Err(error) => self.error = Some(error.to_string()),
+            }
+        }
+        if self.job.is_some() || self.pending_run {
+            ctx.request_repaint_after(std::time::Duration::from_millis(16));
+        }
+    }
+
+    /// Draw inside the host's existing outer container.
+    pub fn show(&mut self, ui: &mut Ui) -> Vec<NodeAction> {
+        ui.painter().rect_filled(ui.available_rect_before_wrap(), 0, Tokens::get().panel);
+        self.poll(ui.ctx());
+        let mut actions = Vec::new();
+        let now = ui.input(|input| input.time);
+        self.toolbar(ui, &mut actions, now);
+        ui.separator();
+        if let Some(error) = &self.error {
+            ui.colored_label(Tokens::get().error, error);
+        }
+        let hint = if self.placing.is_some() {
+            "ui.nodes.place_hint"
+        } else if self.wire_start.is_some() {
+            "ui.nodes.wire_hint"
+        } else {
+            "ui.nodes.canvas_hint"
+        };
+        ui.label(egui::RichText::new(tr(hint)).small().color(Tokens::get().text_dim));
+        let available = ui.available_size();
+        if available.x < 560.0 {
+            self.canvas(ui, available.y.min(340.0));
+            ui.separator();
+            self.inspector(ui, &mut actions, now);
+        } else {
+            ui.horizontal_top(|ui| {
+                let inspector_width = 250.0;
+                ui.allocate_ui_with_layout(
+                    vec2((available.x - inspector_width - 18.0).max(260.0), available.y),
+                    egui::Layout::top_down(egui::Align::Min),
+                    |ui| {
+                        self.canvas(ui, available.y);
+                    },
+                );
+                ui.separator();
+                ui.allocate_ui_with_layout(vec2(inspector_width, available.y), egui::Layout::top_down(egui::Align::Min), |ui| {
+                    egui::ScrollArea::vertical().id_salt("node-inspector").show(ui, |ui| self.inspector(ui, &mut actions, now));
+                });
+            });
+        }
+        actions
+    }
+
+    fn toolbar(&mut self, ui: &mut Ui, actions: &mut Vec<NodeAction>, now: f64) {
+        ui.horizontal_wrapped(|ui| {
+            ui.strong(tr("ui.nodes.title"));
+            if self.is_dirty() {
+                ui.label(egui::RichText::new(tr("ui.nodes.unsaved")).small().color(Tokens::get().text_dim));
+            }
+            crate::ui_kit::Menu::button(ui, tr("ui.nodes.add"), |ui| {
+                for group in ["Math", "Curves", "Transform", "Pattern", "Solid", "Print"] {
+                    crate::ui_kit::Menu::button(ui, group_label(group), |ui| {
+                        for c in solidcraft_graph::COMPONENTS.iter().filter(|c| c.group == group) {
+                            if crate::ui_kit::button(ui, component_label(c.name), crate::ui_kit::Button::Normal).clicked() {
+                                self.placing = Some(c.name);
+                                self.wire_start = None;
+                                ui.close();
+                            }
+                        }
+                    });
+                }
+            });
+            if action_button(ui, "ui.nodes.run", "play", true).clicked() {
+                self.run(ui.ctx());
+            }
+            if action_button(ui, "ui.nodes.stop", "stop", self.job.is_some() || self.pending_run).clicked() {
+                self.cancel();
+            }
+            if crate::ui_kit::checkbox(ui, tr("ui.nodes.live"), &mut self.auto_run).changed() && self.auto_run {
+                self.pending_run = true;
+            }
+            ui.separator();
+            if action_button(ui, "ui.nodes.undo", "undo", !self.undo.is_empty()).clicked() {
+                self.undo(now);
+            }
+            if action_button(ui, "ui.nodes.redo", "redo", !self.redo.is_empty()).clicked() {
+                self.redo(now);
+            }
+            if action_button(ui, "ui.nodes.open", "open", true).clicked() {
+                actions.push(NodeAction::OpenJson);
+            }
+            if action_button(ui, "ui.nodes.save", "save", true).clicked() {
+                match self.to_json() {
+                    Ok(text) => actions.push(NodeAction::SaveJson(text)),
+                    Err(error) => self.error = Some(error),
+                }
+            }
+            if crate::ui_kit::button(ui, tr("ui.nodes.home"), crate::ui_kit::Button::Normal).clicked() {
+                self.scroll_to = self.selected.or_else(|| self.graph.nodes.keys().next().copied());
+            }
+            crate::ui_kit::Menu::button(ui, tr("ui.nodes.document"), |ui| {
+                if crate::ui_kit::button(ui, tr("ui.nodes.example"), crate::ui_kit::Button::Normal).clicked() {
+                    match sample_graph().map_err(|error| error.to_string()).and_then(|graph| self.replace_graph(graph)) {
+                        Ok(()) => {}
+                        Err(error) => self.error = Some(error),
+                    }
+                    ui.close();
+                }
+                if crate::ui_kit::button(ui, tr("ui.nodes.clear"), crate::ui_kit::Button::Normal).clicked() {
+                    if let Err(error) = self.replace_graph(Graph::new()) {
+                        self.error = Some(error);
+                    }
+                    ui.close();
+                }
+            });
+            let status = if self.job.is_some() {
+                "ui.nodes.running"
+            } else if self.evaluated_revision != Some(self.revision) {
+                "ui.nodes.changed"
+            } else if self.evaluation.as_ref().is_some_and(|evaluation| !evaluation.errors.is_empty()) {
+                "ui.nodes.errors"
+            } else {
+                "ui.nodes.ready"
+            };
+            ui.label(egui::RichText::new(tr(status)).small().color(Tokens::get().text_dim));
+        });
+    }
+}
+
+fn action_button(ui: &mut Ui, label: &str, icon: &str, enabled: bool) -> egui::Response {
+    crate::ui_kit::icon_label_button(ui, tr(label), icon, enabled, false)
+}
+
+fn component_label(name: &'static str) -> &'static str {
+    let key = match name {
+        "Number" => "ui.nodes.component.number",
+        "Add" => "ui.nodes.component.add",
+        "Subtract" => "ui.nodes.component.subtract",
+        "Multiply" => "ui.nodes.component.multiply",
+        "Divide" => "ui.nodes.component.divide",
+        "Series" => "ui.nodes.component.series",
+        "Point" => "ui.nodes.component.point",
+        "Circle" => "ui.nodes.component.circle",
+        "Rectangle" => "ui.nodes.component.rectangle",
+        "Move" => "ui.nodes.component.move",
+        "Rotate" => "ui.nodes.component.rotate",
+        "Linear Pattern" => "ui.nodes.component.linear_pattern",
+        "Circular Pattern" => "ui.nodes.component.circular_pattern",
+        "Extrude" => "ui.nodes.component.extrude",
+        "Merge Solids" => "ui.nodes.component.merge_solids",
+        "Slice" => "ui.nodes.component.slice",
+        "G-code" => "ui.nodes.component.gcode",
+        _ => return name,
+    };
+    tr(key)
+}
+
+fn group_label(name: &'static str) -> &'static str {
+    tr(match name {
+        "Math" => "ui.nodes.group.math",
+        "Curves" => "ui.nodes.group.curves",
+        "Transform" => "ui.nodes.group.transform",
+        "Pattern" => "ui.nodes.group.pattern",
+        "Solid" => "ui.nodes.group.solid",
+        "Print" => "ui.nodes.group.print",
+        _ => return name,
+    })
+}
+
+fn input_label(name: &'static str) -> &'static str {
+    tr(match name {
+        "value" => "ui.nodes.input.value",
+        "a" => "ui.nodes.input.a",
+        "b" => "ui.nodes.input.b",
+        "result" => "ui.nodes.input.result",
+        "start" => "ui.nodes.input.start",
+        "step" => "ui.nodes.input.step",
+        "count" => "ui.nodes.input.count",
+        "list" => "ui.nodes.input.list",
+        "x" => "ui.nodes.input.x",
+        "y" => "ui.nodes.input.y",
+        "z" => "ui.nodes.input.z",
+        "point" => "ui.nodes.input.point",
+        "radius" => "ui.nodes.input.radius",
+        "segments" => "ui.nodes.input.segments",
+        "curve" => "ui.nodes.input.curve",
+        "width" => "ui.nodes.input.width",
+        "depth" => "ui.nodes.input.depth",
+        "shape" => "ui.nodes.input.shape",
+        "degrees" => "ui.nodes.input.degrees",
+        "dx" => "ui.nodes.input.dx",
+        "dy" => "ui.nodes.input.dy",
+        "dz" => "ui.nodes.input.dz",
+        "shapes" => "ui.nodes.input.shapes",
+        "height" => "ui.nodes.input.height",
+        "solid" => "ui.nodes.input.solid",
+        "solids" => "ui.nodes.input.solids",
+        "layer height" => "ui.nodes.input.layer_height",
+        "layers" => "ui.nodes.input.layers",
+        "line width" => "ui.nodes.input.line_width",
+        "nozzle temp" => "ui.nodes.input.nozzle_temp",
+        "bed temp" => "ui.nodes.input.bed_temp",
+        "walls" => "ui.nodes.input.walls",
+        "infill spacing" => "ui.nodes.input.infill_spacing",
+        "text" => "ui.nodes.input.text",
+        _ => return name,
+    })
+}
+
+fn modifier_label(modifier: Modifier) -> &'static str {
+    tr(match modifier {
+        Modifier::None => "ui.nodes.modifier.none",
+        Modifier::Flatten => "ui.nodes.modifier.flatten",
+        Modifier::Graft => "ui.nodes.modifier.graft",
+    })
+}
diff --git a/crates/ui-egui/src/node_editor/canvas.rs b/crates/ui-egui/src/node_editor/canvas.rs
new file mode 100644
index 0000000..ffd8dca
--- /dev/null
+++ b/crates/ui-egui/src/node_editor/canvas.rs
@@ -0,0 +1,240 @@
+use egui::{Align2, FontId, Pos2, Rect, Sense, Stroke, StrokeKind, Ui, pos2, vec2};
+use solidcraft_graph::{Node, NodeId, component};
+
+use super::{NodeEditor, Tokens, component_label, group_label, input_label, tr};
+
+const WIDTH: f32 = 220.0;
+const HEADER: f32 = 54.0;
+const ROW: f32 = 25.0;
+
+fn card_rect(origin: Pos2, node: &Node) -> Rect {
+    let rows = node.inputs.len().max(1);
+    Rect::from_min_size(origin + vec2(node.at.0, node.at.1), vec2(WIDTH, HEADER + rows as f32 * ROW + 24.0))
+}
+
+fn input_at(rect: Rect, input: usize) -> Pos2 {
+    pos2(rect.left(), rect.top() + HEADER + (input as f32 + 0.5) * ROW)
+}
+
+fn output_at(rect: Rect, output: usize) -> Pos2 {
+    pos2(rect.right(), rect.top() + HEADER + (output as f32 + 0.5) * ROW)
+}
+
+fn wire(painter: &egui::Painter, start: Pos2, end: Pos2, color: egui::Color32) {
+    let bend = ((end.x - start.x).abs() * 0.45).clamp(36.0, 180.0);
+    painter.add(egui::epaint::CubicBezierShape::from_points_stroke(
+        [start, start + vec2(bend, 0.0), end - vec2(bend, 0.0), end],
+        false,
+        egui::Color32::TRANSPARENT,
+        Stroke::new(2.0, color),
+    ));
+}
+
+impl NodeEditor {
+    pub(super) fn canvas(&mut self, ui: &mut Ui, height: f32) {
+        let t = Tokens::get();
+        let now = ui.input(|input| input.time);
+        // ScrollArea owns graph scrolling. It is a document layout, not a second model camera.
+        egui::ScrollArea::both().id_salt("node-canvas").auto_shrink([false, false]).max_height(height.max(160.0)).show_viewport(ui, |ui, view| {
+            // Fill the visible workspace after resizing, while retaining scrollable graph extents.
+            let size = self.graph.nodes.values().fold(view.size(), |size, node| {
+                let rect = card_rect(Pos2::ZERO, node);
+                vec2(size.x.max(rect.right() + 100.0), size.y.max(rect.bottom() + 100.0))
+            });
+            let (rect, background) = ui.allocate_exact_size(size, Sense::click());
+            let painter = ui.painter().with_clip_rect(ui.clip_rect().intersect(rect));
+            painter.rect_filled(rect, 0, t.viewport_bottom);
+            let clip = painter.clip_rect();
+            let step = 24.0;
+            let mut x = rect.left() + ((clip.left() - rect.left()) / step).floor() * step;
+            while x < clip.right() {
+                let mut y = rect.top() + ((clip.top() - rect.top()) / step).floor() * step;
+                while y < clip.bottom() {
+                    painter.circle_filled(pos2(x, y), 0.8, t.grid);
+                    y += step;
+                }
+                x += step;
+            }
+            for node in self.graph.nodes.values() {
+                let destination = card_rect(rect.min, node);
+                for (input, socket) in node.inputs.iter().enumerate() {
+                    if let Some(start) = socket.wire.and_then(|wire| self.graph.nodes.get(&wire.from).map(|node| (wire.output, node))) {
+                        let source = card_rect(rect.min, start.1);
+                        wire(&painter, output_at(source, start.0), input_at(destination, input), t.accent);
+                    }
+                }
+            }
+            if let Some((id, output)) = self.wire_start
+                && let Some(node) = self.graph.nodes.get(&id)
+                && let Some(pointer) = ui.input(|input| input.pointer.hover_pos())
+            {
+                wire(&painter, output_at(card_rect(rect.min, node), output), pointer, t.text_dim);
+            }
+            let ids: Vec<NodeId> = self.graph.nodes.keys().copied().collect();
+            for id in ids {
+                self.card(ui, &painter, rect.min, id, now);
+            }
+            if background.clicked() {
+                if let Some(name) = self.placing {
+                    if let Some(point) = background.interact_pointer_pos() {
+                        let at = (point.x - rect.left(), point.y - rect.top());
+                        self.checkpoint();
+                        match self.graph.add_node(name, at) {
+                            Ok(id) => {
+                                self.selected = Some(id);
+                                self.placing = None;
+                                self.changed(now);
+                            }
+                            Err(error) => self.error = Some(error.to_string()),
+                        }
+                    }
+                } else {
+                    self.selected = None;
+                }
+            }
+            if background.secondary_clicked() || ui.input(|input| input.key_pressed(egui::Key::Escape)) {
+                self.placing = None;
+                self.wire_start = None;
+            }
+            if let Some(name) = self.placing
+                && let Some(pointer) = ui.input(|input| input.pointer.hover_pos()).filter(|p| clip.contains(*p))
+            {
+                painter.rect_stroke(Rect::from_min_size(pointer, vec2(WIDTH, 110.0)), 8, Stroke::new(1.5, t.accent), StrokeKind::Inside);
+                painter.text(pointer + vec2(14.0, 16.0), Align2::LEFT_TOP, component_label(name), FontId::proportional(14.0), t.text);
+            }
+        });
+    }
+
+    fn card(&mut self, ui: &mut Ui, painter: &egui::Painter, origin: Pos2, id: NodeId, now: f64) {
+        let Some(node) = self.graph.nodes.get(&id) else { return };
+        let Some(c) = component(node.component) else { return };
+        let rect = card_rect(origin, node);
+        if self.scroll_to == Some(id) {
+            ui.scroll_to_rect(rect.expand(32.0), Some(egui::Align::Center));
+            self.scroll_to = None;
+        }
+        if !painter.clip_rect().intersects(rect.expand(12.0)) {
+            return;
+        }
+        let t = Tokens::get();
+        let error = self.evaluation().and_then(|evaluation| evaluation.errors.get(&id)).cloned();
+        let selected = self.selected == Some(id);
+        let border = if error.is_some() {
+            t.error
+        } else if selected {
+            t.accent
+        } else {
+            t.border
+        };
+        painter.rect_filled(rect, 8, t.panel);
+        painter.rect_stroke(rect, 8, Stroke::new(if selected || error.is_some() { 2.0 } else { 1.0 }, border), StrokeKind::Inside);
+        let header = Rect::from_min_size(rect.min, vec2(WIDTH, HEADER));
+        painter.text(rect.min + vec2(14.0, 13.0), Align2::LEFT_TOP, component_label(c.name), FontId::proportional(15.0), t.text);
+        painter.text(rect.min + vec2(14.0, 33.0), Align2::LEFT_TOP, group_label(c.group), FontId::proportional(10.0), t.text_dim);
+        painter.text(
+            pos2(rect.right() - 12.0, rect.top() + 14.0),
+            Align2::RIGHT_TOP,
+            format!("#{}", id.0.saturating_add(1)),
+            FontId::proportional(10.0),
+            t.text_dim,
+        );
+        painter.line_segment([pos2(rect.left() + 10.0, header.bottom()), pos2(rect.right() - 10.0, header.bottom())], Stroke::new(1.0, t.border));
+        let header_response = ui.interact(header, ui.make_persistent_id(("node-card", id.0)), Sense::click_and_drag());
+        crate::scenario::publish_target(&format!("nodes:card:{}", id.0), header);
+        header_response.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, true, component_label(c.name)));
+        if header_response.clicked() {
+            self.selected = Some(id);
+        }
+        if header_response.drag_started() {
+            self.selected = Some(id);
+            self.drag = Some((id, node.at));
+            self.checkpoint();
+        }
+        if header_response.dragged_by(egui::PointerButton::Primary) {
+            let delta = ui.input(|input| input.pointer.delta());
+            if let Some(node) = self.graph.nodes.get(&id) {
+                let at = ((node.at.0 + delta.x).clamp(0.0, 1_000_000.0 - WIDTH), (node.at.1 + delta.y).clamp(0.0, 1_000_000.0 - 300.0));
+                if let Err(error) = self.graph.move_node(id, at) {
+                    self.error = Some(error.to_string());
+                }
+            }
+        }
+        if header_response.drag_stopped() {
+            self.drag = None;
+        }
+        let mut connect_to = None;
+        for (index, input) in c.inputs.iter().enumerate() {
+            let at = input_at(rect, index);
+            let socket = self.graph.nodes.get(&id).and_then(|node| node.inputs.get(index));
+            let connected = socket.is_some_and(|socket| socket.wire.is_some());
+            let fill = if connected { t.accent } else { t.control_fill };
+            painter.circle_filled(at, 5.5, fill);
+            painter.circle_stroke(at, 5.5, Stroke::new(1.5, if connected { t.accent } else { t.text_dim }));
+            painter.text(at + vec2(13.0, 0.0), Align2::LEFT_CENTER, input_label(input.name), FontId::proportional(11.0), t.text_dim);
+            let hit = Rect::from_center_size(at, vec2(22.0, 22.0));
+            let response = ui.interact(hit, ui.make_persistent_id(("node-input", id.0, index)), Sense::click());
+            crate::scenario::publish_target(&format!("nodes:input:{}:{index}", id.0), hit);
+            response.widget_info(|| {
+                egui::WidgetInfo::labeled(egui::WidgetType::Button, true, format!("{}: {}", component_label(c.name), input_label(input.name)))
+            });
+            if response.clicked() {
+                self.selected = Some(id);
+                if self.wire_start.is_some() {
+                    connect_to = Some(index);
+                }
+            }
+            response.on_hover_text(tr("ui.nodes.input_hint"));
+        }
+        for (output, name) in c.outputs.iter().enumerate() {
+            let at = output_at(rect, output);
+            painter.circle_filled(at, 5.5, t.accent);
+            painter.text(at - vec2(13.0, 0.0), Align2::RIGHT_CENTER, input_label(name), FontId::proportional(11.0), t.text);
+            let hit = Rect::from_center_size(at, vec2(22.0, 22.0));
+            let response = ui.interact(hit, ui.make_persistent_id(("node-output", id.0, output)), Sense::click());
+            crate::scenario::publish_target(&format!("nodes:output:{}:{output}", id.0), hit);
+            response.widget_info(|| {
+                egui::WidgetInfo::labeled(egui::WidgetType::Button, true, format!("{}: {}", component_label(c.name), input_label(name)))
+            });
+            if response.clicked() {
+                self.wire_start = Some((id, output));
+                self.placing = None;
+                self.selected = Some(id);
+            }
+            response.on_hover_text(tr("ui.nodes.output_hint"));
+        }
+        if let Some(input) = connect_to
+            && let Some((source, output)) = self.wire_start
+        {
+            let before = self.graph.clone();
+            match self.graph.connect_checked(source, output, id, input) {
+                Ok(()) => {
+                    self.push_undo(before);
+                    self.wire_start = None;
+                    self.changed(now);
+                }
+                Err(error) => self.error = Some(error.to_string()),
+            }
+        }
+        let status = if error.is_some() {
+            tr("ui.nodes.node_error").to_owned()
+        } else if let Some(tree) = self.evaluation().and_then(|evaluation| evaluation.outputs.get(&(id, 0))) {
+            format!("{} {}", tree.item_count(), tr("ui.nodes.items"))
+        } else {
+            tr("ui.nodes.pending").to_owned()
+        };
+        painter.text(
+            pos2(rect.left() + 14.0, rect.bottom() - 12.0),
+            Align2::LEFT_CENTER,
+            status,
+            FontId::proportional(10.0),
+            if error.is_some() { t.error } else { t.text_dim },
+        );
+        if let Some(error) = error {
+            header_response.on_hover_text(error);
+        }
+        if ui.input(|input| input.pointer.secondary_clicked()) && ui.rect_contains_pointer(rect) {
+            self.wire_start = None;
+            self.placing = None;
+        }
+    }
+}
diff --git a/crates/ui-egui/src/node_editor/inspector.rs b/crates/ui-egui/src/node_editor/inspector.rs
new file mode 100644
index 0000000..97b11b2
--- /dev/null
+++ b/crates/ui-egui/src/node_editor/inspector.rs
@@ -0,0 +1,234 @@
+use egui::Ui;
+use solidcraft_graph::{Modifier, NodeId, Value, component};
+
+use super::{NodeAction, NodeEditor, Tokens, action_button, component_label, input_label, modifier_label, tr};
+
+/// A frame owns only values it can edit. Geometry and large text stay in the graph; selecting a
+/// node must not copy megabytes of mesh data on every pointer repaint.
+enum InputValue {
+    Number(f64),
+    Bool(bool),
+    Text(String),
+    Summary(String),
+}
+
+impl InputValue {
+    fn of(value: &Value) -> Self {
+        match value {
+            Value::Number(number) => Self::Number(*number),
+            Value::Bool(value) => Self::Bool(*value),
+            Value::Text(text) if text.len() <= 4096 => Self::Text(text.clone()),
+            other => Self::Summary(value_summary(other)),
+        }
+    }
+}
+
+impl NodeEditor {
+    pub(super) fn inspector(&mut self, ui: &mut Ui, actions: &mut Vec<NodeAction>, now: f64) {
+        let t = Tokens::get();
+        let Some(id) = self.selected else {
+            ui.heading(tr("ui.nodes.inspector"));
+            ui.label(tr("ui.nodes.select_hint"));
+            return;
+        };
+        let Some(node) = self.graph.nodes.get(&id) else { return };
+        let Some(c) = component(node.component) else { return };
+        let inputs: Vec<_> = node.inputs.iter().map(|socket| (socket.wire, socket.modifier, InputValue::of(&socket.constant))).collect();
+        ui.heading(component_label(c.name));
+        ui.label(egui::RichText::new(format!("#{}", id.0.saturating_add(1))).small().color(t.text_dim));
+        ui.add_space(8.0);
+        for (input, (wire, current_modifier, value)) in inputs.into_iter().enumerate() {
+            let Some(spec) = c.inputs.get(input) else { continue };
+            ui.push_id(("node-inspect", id.0, input), |ui| {
+                ui.strong(input_label(spec.name));
+                if let Some(wire) = wire {
+                    ui.horizontal_wrapped(|ui| {
+                        let source =
+                            self.graph.nodes.get(&wire.from).map(|source| component_label(source.component)).unwrap_or(tr("ui.nodes.missing"));
+                        ui.label(format!("{source} #{}", wire.from.0.saturating_add(1)));
+                        if crate::ui_kit::button(ui, tr("ui.nodes.disconnect"), crate::ui_kit::Button::Small).clicked() {
+                            self.checkpoint();
+                            if let Err(error) = self.graph.disconnect(id, input) {
+                                self.error = Some(error.to_string());
+                            } else {
+                                self.changed(now);
+                            }
+                        }
+                    });
+                } else if matches!(spec.name, "shape" | "curve" | "solid" | "solids" | "layers") && matches!(&value, InputValue::Number(_)) {
+                    ui.label(egui::RichText::new(tr("ui.nodes.connect_shape")).small().color(t.text_dim));
+                } else {
+                    match value {
+                        InputValue::Number(value) => self.number_input(ui, id, input, spec.name, value, now),
+                        InputValue::Bool(mut value) => {
+                            if crate::ui_kit::checkbox(ui, tr("ui.nodes.enabled"), &mut value).changed() {
+                                self.checkpoint();
+                                self.set_input(id, input, Value::Bool(value), now);
+                            }
+                        }
+                        InputValue::Text(mut text) => {
+                            if crate::ui_kit::text_area(ui, input_label(spec.name), ui.make_persistent_id("text"), &mut text, 3, 4096).changed() {
+                                self.checkpoint();
+                                self.set_input(id, input, Value::Text(text), now);
+                            }
+                        }
+                        InputValue::Summary(text) => {
+                            ui.label(text);
+                        }
+                    }
+                }
+                let choices = [Modifier::None, Modifier::Flatten, Modifier::Graft];
+                let mut choice = choices.iter().position(|choice| *choice == current_modifier).unwrap_or(0);
+                let labels = choices.map(modifier_label);
+                crate::ui_kit::dropdown(ui, "modifier", &mut choice, &labels);
+                let modifier = choices.get(choice).copied().unwrap_or(Modifier::None);
+                if modifier != current_modifier {
+                    self.checkpoint();
+                    match self.graph.set_modifier(id, input, modifier) {
+                        Ok(()) => self.changed(now),
+                        Err(error) => self.error = Some(error.to_string()),
+                    }
+                }
+                ui.add_space(10.0);
+            });
+        }
+        ui.separator();
+        ui.strong(tr("ui.nodes.output"));
+        if let Some(error) = self.evaluation().and_then(|evaluation| evaluation.errors.get(&id)) {
+            ui.colored_label(t.error, error);
+        } else if let Some(evaluation) = self.evaluation() {
+            if let Some(tree) = evaluation.outputs.get(&(id, 0)) {
+                ui.label(format!("{} {} / {} {}", tree.item_count(), tr("ui.nodes.items"), tree.branches.len(), tr("ui.nodes.branches")));
+                let first = tree.branches.values().flatten().next();
+                if let Some(value) = first {
+                    ui.label(value_summary(value));
+                }
+                let mut mesh_count = 0usize;
+                for value in tree.branches.values().flatten() {
+                    if let Value::Solid(triangles) = value {
+                        mesh_count = mesh_count.saturating_add(triangles.len());
+                    }
+                }
+                if mesh_count > 0 && mesh_count <= 100_000 {
+                    if action_button(ui, "ui.nodes.use_mesh", "import", true).clicked() {
+                        let mut mesh = Vec::with_capacity(mesh_count);
+                        for value in tree.branches.values().flatten() {
+                            if let Value::Solid(triangles) = value {
+                                mesh.extend(triangles.iter().copied());
+                            }
+                        }
+                        actions.push(NodeAction::PreviewMesh(std::sync::Arc::new(mesh)));
+                    }
+                } else if mesh_count > 100_000 {
+                    ui.colored_label(t.warning, tr("ui.nodes.mesh_too_large"));
+                }
+                if let Some(Value::Text(text)) = first {
+                    if c.name == "G-code" {
+                        ui.colored_label(t.warning, tr("ui.nodes.print_unverified"));
+                        if action_button(ui, "ui.nodes.export_gcode", "export", true).clicked() {
+                            actions.push(NodeAction::ExportGcode(text.clone()));
+                        }
+                    } else {
+                        let preview: String = text.chars().take(400).collect();
+                        ui.monospace(preview);
+                    }
+                }
+            } else {
+                ui.label(tr("ui.nodes.pending"));
+            }
+        } else {
+            ui.label(tr("ui.nodes.run_hint"));
+        }
+        ui.add_space(12.0);
+        if action_button(ui, "ui.nodes.delete", "delete", true).clicked() {
+            self.checkpoint();
+            self.graph.remove_node(id);
+            self.selected = None;
+            self.wire_start = self.wire_start.filter(|(source, _)| *source != id);
+            self.changed(now);
+        }
+    }
+
+    fn set_input(&mut self, id: NodeId, input: usize, value: Value, now: f64) {
+        match self.graph.set_constant(id, input, value) {
+            Ok(()) => self.changed(now),
+            Err(error) => self.error = Some(error.to_string()),
+        }
+    }
+
+    fn number_input(&mut self, ui: &mut Ui, id: NodeId, input: usize, name: &str, value: f64, now: f64) {
+        let (range, integer) = number_range(name);
+        let range = range.start().min(value)..=range.end().max(value);
+        let mut number = value;
+        let width = ui.available_width();
+        let response = ui
+            .horizontal(|ui| {
+                let slider = ui
+                    .allocate_ui_with_layout(egui::vec2((width - 80.0).max(70.0), 26.0), egui::Layout::left_to_right(egui::Align::Center), |ui| {
+                        crate::ui_kit::slider(ui, &mut number, range, crate::ui_kit::Slider { integer, show_value: false, ..Default::default() })
+                    })
+                    .inner;
+                let exact = crate::ui_kit::number_field(
+                    ui,
+                    &mut number,
+                    value.min(-1_000_000.0)..=value.max(1_000_000.0),
+                    if integer { 1.0 } else { 0.1 },
+                    "",
+                );
+                slider.union(exact)
+            })
+            .inner;
+        crate::scenario::publish_target(&format!("nodes:value:{}:{input}", id.0), response.rect);
+        if response.drag_started() || response.gained_focus() {
+            self.number_edit = Some(self.graph.clone());
+        }
+        if response.changed() {
+            if self.number_edit.is_none() {
+                self.number_edit = Some(self.graph.clone());
+            }
+            if number.is_finite() && number.abs() <= 1_000_000.0 {
+                self.set_input(id, input, Value::Number(number), now);
+            } else {
+                self.error = Some(tr("ui.nodes.invalid_number").into());
+            }
+        }
+        if (response.drag_stopped()
+            || response.lost_focus()
+            || (response.changed() && !response.dragged())
+            || ui.input(|input| input.pointer.secondary_clicked()))
+            && let Some(before) = self.number_edit.take()
+            && before != self.graph
+        {
+            self.push_undo(before);
+        }
+    }
+}
+
+fn number_range(name: &str) -> (std::ops::RangeInclusive<f64>, bool) {
+    match name {
+        "segments" => (3.0..=128.0, true),
+        "count" => (1.0..=64.0, true),
+        "walls" => (0.0..=8.0, true),
+        "layer height" => (0.04..=0.6, false),
+        "line width" => (0.1..=1.0, false),
+        "nozzle temp" => (0.0..=300.0, true),
+        "bed temp" => (0.0..=120.0, true),
+        "radius" | "width" | "depth" | "height" => (0.1..=100.0, false),
+        "degrees" => (-180.0..=180.0, false),
+        "infill spacing" => (0.0..=20.0, false),
+        _ => (-100.0..=100.0, false),
+    }
+}
+
+fn value_summary(value: &Value) -> String {
+    match value {
+        Value::Number(number) => format!("{number:.5}"),
+        Value::Bool(value) => tr(if *value { "ui.nodes.true" } else { "ui.nodes.false" }).into(),
+        Value::Text(text) => format!("{} {}", text.len(), tr("ui.nodes.bytes")),
+        Value::Point(point) => format!("({:.3}, {:.3}, {:.3})", point.x, point.y, point.z),
+        Value::Poly(poly) => format!("{} {}", poly.pts.len(), tr("ui.nodes.points")),
+        Value::Solid(triangles) => format!("{} {}", triangles.len(), tr("ui.nodes.triangles")),
+        Value::Layers(layers) => format!("{} {}", layers.layers.len(), tr("ui.nodes.layers")),
+        Value::List(values) => format!("{} {}", values.len(), tr("ui.nodes.items")),
+    }
+}
diff --git a/crates/ui-egui/src/node_editor/tests.rs b/crates/ui-egui/src/node_editor/tests.rs
new file mode 100644
index 0000000..5b87b97
--- /dev/null
+++ b/crates/ui-egui/src/node_editor/tests.rs
@@ -0,0 +1,292 @@
+use super::*;
+
+fn frame(editor: &mut NodeEditor, ctx: &egui::Context, events: Vec<egui::Event>) {
+    crate::scenario::clear_handles();
+    let _ = ctx.run_ui(
+        egui::RawInput {
+            screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1200.0, 800.0))),
+            focused: true,
+            events,
+            ..Default::default()
+        },
+        |ui| {
+            editor.show(ui);
+        },
+    );
+}
+
+fn pointer(at: egui::Pos2, button: egui::PointerButton, pressed: bool) -> Vec<egui::Event> {
+    vec![egui::Event::PointerMoved(at), egui::Event::PointerButton { pos: at, button, pressed, modifiers: egui::Modifiers::NONE }]
+}
+
+fn click(editor: &mut NodeEditor, ctx: &egui::Context, at: egui::Pos2) {
+    frame(editor, ctx, pointer(at, egui::PointerButton::Primary, true));
+    frame(editor, ctx, pointer(at, egui::PointerButton::Primary, false));
+}
+
+fn idle_editor() -> NodeEditor {
+    let mut editor = NodeEditor::default();
+    editor.auto_run = false;
+    editor.pending_run = false;
+    editor
+}
+
+#[test]
+fn graph_file_failure_preserves_the_open_document_and_history() {
+    let mut editor = idle_editor();
+    let before = editor.graph.clone();
+    assert!(editor.load_json("{bad json}").is_err());
+    assert_eq!(editor.graph, before);
+    assert!(editor.undo.is_empty());
+    let saved = editor.to_json().unwrap();
+    editor.load_json(&saved).unwrap();
+    assert!(!editor.is_dirty());
+}
+
+#[test]
+fn hostile_file_errors_keep_a_bounded_utf8_banner_and_preserve_the_graph() {
+    let mut editor = idle_editor();
+    let before = editor.graph.clone();
+    let mut document: serde_json::Value = serde_json::from_str(&editor.to_json().unwrap()).unwrap();
+    document["nodes"][0]["component"] = serde_json::Value::String("🧊".repeat(20_000));
+    let error = editor.load_json(&document.to_string()).unwrap_err();
+    assert!(error.len() > 50_000, "the parser can echo an untrusted component name");
+    editor.report_error(error);
+    let banner = editor.error.as_ref().unwrap();
+    assert!(banner.chars().count() <= MAX_ERROR_CHARS);
+    assert!(banner.ends_with('…'));
+    assert!(banner.contains('🧊'), "the visible prefix must keep valid Unicode characters");
+    assert_eq!(editor.graph, before);
+    editor.report_error("A short error");
+    assert_eq!(editor.error.as_deref(), Some("A short error"));
+}
+
+#[test]
+fn stale_worker_results_are_not_shown_for_edited_values() {
+    let mut editor = idle_editor();
+    let old = editor.graph.evaluate().unwrap();
+    let revision = editor.revision;
+    editor.changed(0.0);
+    editor.finish(Ok(old), revision);
+    assert!(editor.evaluation().is_none());
+}
+
+#[test]
+fn async_save_marks_its_snapshot_and_keeps_new_edits_dirty() {
+    let mut editor = idle_editor();
+    let saved = editor.to_json().unwrap();
+    editor.mark_saved();
+    assert!(!editor.is_dirty());
+    editor.graph.add_node("Number", (0.0, 0.0)).unwrap();
