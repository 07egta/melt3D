+    #[test]
+    fn clamped_tiny_endpoints_are_exact_in_both_directions() {
+        let curve = NurbsCurve::new(
+            1,
+            vec![0.0, 0.0, 1.0, 1.0],
+            vec![Vec3::X * 1e-230, Vec3::X],
